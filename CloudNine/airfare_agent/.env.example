# Database Connection String
# Defaults to local SQLite file database for instant setup.
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/airfare_db
DATABASE_URL=sqlite:///./data/airfare.db

# Scraper Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
MAX_RETRIES=2
REQUEST_DELAY_SECONDS=2.0

# Logging
LOG_LEVEL=INFO

# Master Data Output
MASTER_CSV_PATH=./data/airfare_master.csv
MASTER_PARQUET_PATH=./data/airfare_master.parquet
